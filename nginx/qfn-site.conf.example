# Every client on this front door goes through the cache-affinity router (qfn_router), which spreads work
# between this box and qwen.nj02.gurov.us and keeps a conversation on the box that has it parked.
# The local engine on :9931 is only reached if the router is down (proxy_next_upstream below).
upstream qfn_router {
    server 127.0.0.1:8080 max_fails=3 fail_timeout=10s;
    server 127.0.0.1:9931 backup;      # router unavailable: answer locally, no balancing
}


server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;   # this front door's own names

    client_max_body_size 64m;

    # No access log: request lines and any URI metadata must not persist on disk.
    access_log off;
    # Keep the whole allowed request body in RAM (== client_max_body_size), so nginx never spills a prompt
    # to /var/lib/nginx/body. Bodies are forwarded and then dropped; nothing is written to disk.
    client_body_buffer_size 64m;

    # long prefills / long generations: do not cut the connection
    proxy_read_timeout 7200s;
    proxy_send_timeout 7200s;
    proxy_connect_timeout 10s;

    location / {
        proxy_pass http://qfn_router;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 2;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE token stream must pass through unbuffered
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
    }
}
